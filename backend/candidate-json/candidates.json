    "officialStatements": [
      {
        "id": "st-1",
        "topic": "Economy",
        "statement": "Domestic semiconductor manufacturing and precision supply chains are matter of national security. We cannot allow critical industrial tooling to depend entirely on foreign single points of failure.",
        "context": "Keynote Address at Pacific Northwest Advanced Manufacturing Forum",
        "date": "2026-03-12",
        "documentType": "Speech Transcript",
        "source": {
          "title": "U.S. Senate Press Record - Vance Speech at PNW Forum",
          "url": "https://www.vance.senate.gov/press-releases/2026-03-12-pnw-manufacturing",
          "organization": "U.S. Senate Official Office",
          "tier": "Tier 1 - Government"
        }
      },
      {
        "id": "st-2",
        "topic": "Transportation",
        "statement": "Electrifying regional transit routes and expediting grade separation projects directly cuts commute times while reducing particulate emissions in frontline highway corridors.",
        "context": "Hearing of the Senate Commerce, Science, and Transportation Committee",
        "date": "2025-11-18",
        "documentType": "Congressional Hearing Transcript",
        "source": {
          "title": "Senate Hearing 119-142 Transcript",
          "url": "https://www.commerce.senate.gov/hearings/2025/11/transit-electrification-oversight",
          "organization": "U.S. Senate Committee on Commerce",
          "tier": "Tier 1 - Government"
        }
      },
      {
        "id": "st-3",
        "topic": "Education",
        "statement": "Four-year degrees must not be the sole subsidized path to middle-class stability. Federal Pell grants must expand to accredited technical apprenticeships and high-voltage grid technician certifications.",
        "context": "Floor Statement introducing the Career Pathway Equity Act",
        "date": "2026-02-04",
        "documentType": "Congressional Record",
        "source": {
          "title": "172 Cong. Rec. S940 - Career Pathway Equity Act Statement",
          "url": "https://www.congress.gov/crec/2026/02/04/CREC-2026-02-04-pt1-PgS940.pdf",
          "organization": "Library of Congress",
          "tier": "Tier 1 - Government"
        }
      },
      {
        "id": "st-4",
        "topic": "Healthcare",
        "statement": "Rural hospital emergency departments require targeted capital protection. When an obstetric unit closes in a county of forty thousand people, the resulting mortality rates are a systemic regulatory failure.",
        "context": "Bipartisan Healthcare Round-table with Washington State Hospital Association",
        "date": "2025-08-14",
        "documentType": "Official Press Release",
        "source": {
          "title": "Press Statement: Vance Announces Rural Health Capital Stability Plan",
          "url": "https://www.vance.senate.gov/press-releases/2025-08-14-rural-health",
          "organization": "U.S. Senate Official Office",
          "tier": "Tier 1 - Government"
        }
      },
      {
        "id": "st-5",
        "topic": "Environment",
        "statement": "Decarbonization must be paired with firm baseload capacity. We cannot replace coal and gas with intermittent sources without simultaneously deploying nuclear small modular reactors and pumped hydro storage.",
        "context": "Symposium on Western Power Grid Reliability",
        "date": "2026-05-19",
        "documentType": "Speech Transcript",
        "source": {
          "title": "Senate Energy & Natural Resources Hearing Records",
          "url": "https://www.energy.senate.gov/hearings/2026/5/western-grid-reliability",
          "organization": "U.S. Senate Committee on Energy",
          "tier": "Tier 1 - Government"
        }
      },
      {
        "id": "st-6",
        "topic": "Public Safety",
        "statement": "Fentanyl interdiction requires intercepting precursor shipments at container ports before distribution, paired with non-punitive regional crisis stabilization centers.",
        "context": "Senate Judiciary Subcommittee on Border Security and Interdiction",
        "date": "2025-10-09",
        "documentType": "Congressional Record",
